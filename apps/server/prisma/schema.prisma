// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  createdAt     DateTime  @default(now())
  sessions      Session[] @relation("HelperSessions")
}

model Session {
  id            String    @id @default(uuid())
  code          String    @unique
  helperId      String
  helper        User      @relation("HelperSessions", fields: [helperId], references: [id])
  status        String    @default("PENDING") // PENDING, ACTIVE, COMPLETED, CANCELLED
  taskPrompt    String
  actionPlan    String?   // JSON string of WorkflowSteps
  riskScore     Int       @default(0)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  auditLogs     AuditLog[]
}

model AuditLog {
  id            String    @id @default(uuid())
  sessionId     String
  session       Session   @relation(fields: [sessionId], references: [id])
  timestamp     DateTime  @default(now())
  actor         String    // HELPER, CLIENT, AI
  action        String
  details       String?
  consentStatus String?   // APPROVED, DENIED, N/A
}
